# ─────────────────────────────────────────
# SERVEUR
# ─────────────────────────────────────────
PORT=8080
ENV=development   # development | production

# ─────────────────────────────────────────
# BASE DE DONNÉES (PostgreSQL)
# ─────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/devhelp?sslmode=disable
# En production (Neon) : postgresql://user:password@ep-xxx.neon.tech/devhelp?sslmode=require

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─────────────────────────────────────────
# OAUTH
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# ─────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@devhelp.app

# ─────────────────────────────────────────
# CAPTCHA (hCaptcha ou reCAPTCHA)
# ─────────────────────────────────────────
CAPTCHA_SECRET=

# ─────────────────────────────────────────
# STOCKAGE S3 / MinIO
# ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=devhelp
S3_REGION=us-east-1
S3_USE_SSL=false

# ─────────────────────────────────────────
# RABBITMQ
# ─────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MODERATION_QUEUE=moderation.check

# ─────────────────────────────────────────
# INTELLIGENCE ARTIFICIELLE
# ─────────────────────────────────────────
# Choisir un provider : openai | anthropic | ollama
AI_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────
# WEB PUSH (VAPID)
# ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@devhelp.app

# ─────────────────────────────────────────
# SENTRY
# ─────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────
# FRONTEND (utilisé par Vite)
# ─────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=
